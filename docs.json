{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "FitCRM — CRM для фитнес-клуба",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Обзор проекта",
        "groups": [
          {
            "group": "Введение",
            "pages": [
              "index",
              "quickstart",
              "tech-stack"
            ]
          },
          {
            "group": "Архитектура",
            "pages": [
              "architecture/overview",
              "architecture/database",
              "architecture/modules"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Обзор API",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Клиенты",
            "pages": [
              "api-reference/clients/list",
              "api-reference/clients/get",
              "api-reference/clients/create",
              "api-reference/clients/update",
              "api-reference/clients/delete"
            ]
          },
          {
            "group": "Абонементы",
            "pages": [
              "api-reference/memberships/list",
              "api-reference/memberships/create",
              "api-reference/memberships/assign"
            ]
          },
          {
            "group": "Расписание",
            "pages": [
              "api-reference/schedule/list",
              "api-reference/schedule/create",
              "api-reference/schedule/book"
            ]
          },
          {
            "group": "Тренеры",
            "pages": [
              "api-reference/trainers/list",
              "api-reference/trainers/create"
            ]
          },
          {
            "group": "Платежи",
            "pages": [
              "api-reference/payments/list",
              "api-reference/payments/create"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Документация",
          "href": "/",
          "icon": "book-open-cover"
        },
        {
          "anchor": "API",
          "href": "/api-reference/introduction",
          "icon": "code"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Демо",
      "href": "#"
    }
  },
  "footer": {
    "socials": {}
  }
